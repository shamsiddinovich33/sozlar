# Database (Neon / Supabase / local PostgreSQL)
# DATABASE_URL: pooled connection used by the app
# DIRECT_URL: direct (non-pooled) connection used by migrations. Locally both can be equal.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sozlik"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sozlik"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public site URL (used for SEO / OpenGraph links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Upstash Redis (optional; in-memory rate limit is used when empty)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
